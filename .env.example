# Slack app — api.slack.com → your app → Basic Information / OAuth & Permissions
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
SLACK_TEAM_ID=T0123456
PM_USER_IDS=U123,U456

# Vercel KV — run store (A3)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# GitHub — fine-grained PAT, scoped: platform repo actions:write, product repo contents+PRs:write
GH_AGENT_PAT=
PRODUCT_REPO=owner/name
PLATFORM_REPO=prajwalkumar2343/Agent

# PostHog — personal API key ("MCP Server" preset) + project pin; everything
# PostHog goes through the hosted MCP server (mcp.posthog.com), not the REST API
POSTHOG_API_KEY=phx_
POSTHOG_PROJECT_ID=
POSTHOG_MCP_URL=https://mcp.posthog.com/mcp
# POSTHOG_MCP_FEATURES=flags,events,sql   # optional ?features= session scope

# Mintlify docs MCP endpoint (public docs)
DOCS_MCP_URL=https://your-docs-site/mcp

# LLM for spec generation + orchestrator/github agents.
# LLM_PROVIDER picks the backend; set the matching key below.
LLM_PROVIDER=anthropic      # anthropic | openrouter | opencode | opencode-go
# LLM_MODEL=                # optional model id (ANTHROPIC_MODEL still works for anthropic)
# LLM_REASONING_EFFORT=     # minimal|low|medium|high|xhigh ("very high"→xhigh);
                            # zen responses-endpoint models only (gpt-*/grok-*/muse-*)
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=       # openrouter.ai — model ids like anthropic/claude-sonnet-4.5
# OPENCODE_API_KEY=         # opencode.ai key — opencode → zen/v1 pay-per-use, opencode-go →
                            # zen/go/v1 subscription tier (e.g. muse-spark-1.3-contributor,
                            # kimi-*, glm-*, deepseek-*). Go is session-gated — the client
                            # sends x-opencode-session + an opencode/* UA automatically

# VM coding sandbox — pi runs here (packages/runner, feature-run workflow)
SANDBOX_PROVIDER=e2b        # or 'local' for dev (pi as a child process)
E2B_API_KEY=
# E2B_TEMPLATE=base         # custom template with node+pi baked in = faster
PI_PROVIDER=anthropic       # anthropic | openrouter | opencode | opencode-go | openai | google | groq | mistral
PI_MODEL=claude-sonnet-4-5  # per-provider default if unset (openrouter: anthropic/claude-sonnet-4.5)
# PI_API_KEY=               # defaults to the provider's key var — only secret the VM sees

# Internal shared secrets
# Every secret below is referenced in code as a vault:NAME keyword —
# agents only ever see the keyword; values resolve at the tool boundary
# (packages/shared/src/vault.ts).
RUN_CALLBACK_SECRET=
CRON_SECRET=

# Spec generation — 'llm' (default) uses LLM_PROVIDER; 'mock' drafts a
# deterministic spec without an LLM key (local dev / tests)
SPEC_PROVIDER=llm

# Audience simulation provider — 'mock' is in-process; 'mcp' calls the sim app
# over MCP (mock app: npm run sim:mcp — real tools swap in at the same URL)
SIM_PROVIDER=mock
SIM_API_URL=http://127.0.0.1:4100/mcp
SIM_API_KEY=

# Evals + tracing (packages/runner/evals — see evals/README.md)
# RUN_TRACE_PATH=           # cli writes a span-contract AgentTrace here (online scoring reads these)
# TRACE_DIR=                # dir of AgentTrace files for evals/online/score-run.ts
# JUDGE_MODEL=claude-haiku-4-5   # judge model — dev cheap tier; set a frontier model for release gates

# Optional hardening / overrides
GH_WEBHOOK_SECRET=
APP_URL=your-app.vercel.app
ANTHROPIC_MODEL=claude-sonnet-4-5   # anthropic-provider model id (see LLM_PROVIDER)

# Safeguards (see docs/SAFEGUARDS.md)
# AGENT_PAUSED=1              # kill switch — halts intake + merges
# INTAKE_USER_IDS=U123,U456   # who may trigger runs (empty = whole workspace)
# INTAKE_CHANNEL_IDS=C123     # channels that may trigger runs (empty = any)
# INTAKE_PER_USER_PER_DAY=5
# INTAKE_PER_DAY=25
# INTAKE_MAX_ACTIVE=10        # concurrent non-terminal runs
# INTAKE_DEDUP_MINUTES=30
# INTAKE_MAX_CHARS=2000
# ROLLOUT_MAX_PCT=50          # automated rollout ceiling — higher = manual in PostHog
# MAX_VM_INVOCATIONS=4        # pi calls per run (cost ceiling)
# AGENT_BRANCH_PREFIX=agent/  # only refs matching this may be created/committed
# ALLOW_INSECURE_WEBHOOKS=1   # dev only — skips GH webhook signature check
# MERGE_REVIEW=0              # disable the second-opinion diff review (default: on when ANTHROPIC_API_KEY set)
# MERGE_REVIEW_MODEL=claude-haiku-4-5
# SHELL_DENY_PREFIXES=docker,rake secret   # extra forbidden argv prefixes for runShell
# SHELL_ENV_ALLOW=            # force-include env names in the agent shell
# SHELL_ENV_DENY=             # force-exclude env names

# Postgres — user-count cohort deploys (packages/deploy, api/deploy/users).
# Vercel → Storage → Postgres sets POSTGRES_URL automatically; any
# postgres:// DSN works (Neon, Supabase, RDS, local).
POSTGRES_URL=
# POSTGRES_SSL=disable            # local Postgres only
# DEPLOY_MAX_USERS=500            # automated cohort ceiling; 0 disables
# DEPLOY_USERS_TABLE=users        # product table cohorts are drawn from
# DEPLOY_USERS_ID_COLUMN=id
# DEPLOY_USERS_ORDER=             # pick-order column, default: the id column
# DEPLOY_ALLOW_SEED=1             # demo only — lets /api/deploy/users seed users
